+
+    #[cfg(unix)]
+    #[test]
+    fn agent_hook_refuses_a_configuration_file_symlink() {
+        use std::os::unix::fs::symlink;
+
+        let directory = Directory::create();
+        let outside = Directory::create();
+        let executable = std::env::current_exe().unwrap();
+        let outside_config = outside.0.join("hooks.json");
+        let original_bytes = br#"{"hooks":{"Stop":[]}}"#;
+        std::fs::write(&outside_config, original_bytes).unwrap();
+        std::fs::create_dir(directory.0.join(".codex")).unwrap();
+        symlink(
+            &outside_config,
+            directory.0.join(".codex/hooks.json"),
+        )
+        .unwrap();
+
+        assert_eq!(
+            install_codex(&directory.0, &executable).unwrap_err().code,
+            "native_agent_config_unsafe"
+        );
+        assert_eq!(std::fs::read(&outside_config).unwrap(), original_bytes);
+    }
 }
